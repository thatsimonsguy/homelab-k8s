{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TenantBucketsProvisionAndAudit",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketVersions",
        "s3:PutBucketVersioning", "s3:GetBucketVersioning",
        "s3:PutEncryptionConfiguration", "s3:GetEncryptionConfiguration",
        "s3:PutLifecycleConfiguration", "s3:GetLifecycleConfiguration",
        "s3:GetBucketPolicy"
      ],
      "Resource": ["arn:aws:s3:::aggsys-production-*"]
    },
    {
      "Sid": "TenantObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::aggsys-production-*/*"]
    }
  ]
}
